# =============================================================
# Variáveis de ambiente do backend — A&M Procurement Intelligence
#
# COMO USAR:
#   Copie este arquivo para .env (sem o ".example") e preencha
#   os valores reais. O arquivo .env NUNCA deve ser commitado
#   no git (já está no .gitignore).
#
# ALTERNATIVA: defina as variáveis diretamente no terminal antes
#   de rodar o uvicorn (ver COMO_RODAR.md, passo 6).
# =============================================================

# ------------------------------------------------------------
# Claude / Anthropic
# ------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-sua-chave-real-aqui

# ------------------------------------------------------------
# Admin inicial (Degrau 2 — autenticação multiusuário)
#
# Na primeira vez que o servidor sobe com estas variáveis, um
# usuário admin é criado automaticamente com essas credenciais.
# A senha é guardada com hash bcrypt — nunca em texto puro.
#
# Depois que o admin for criado, você pode remover ou alterar
# estas variáveis (o usuário já estará no banco). Se quiser
# redefinir a senha do admin, exclua o registro do banco e
# reinicie o servidor com as variáveis definidas.
# ------------------------------------------------------------
ADMIN_EMAIL=seu.email@alvarezandmarsal.com
ADMIN_SENHA_INICIAL=troque-esta-senha-forte-aqui
